# ====================================================================
# PANDUAN PENGISIAN ENVIRONMENT VARIABLES (UMKM DIGITAL PLATFORM)
# ====================================================================
# Cara pakai:
# 1. Untuk di Komputer/Laptop lokal: Salin (Copy) file ini dan beri nama file baru: .env
# 2. Untuk di Vercel: Masukkan 4 variabel ini di Vercel Dashboard -> Settings -> Environment Variables
# ====================================================================

# 1. DATABASE_URL (Koneksi Database PostgreSQL Supabase)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Tab "URI"
# Gunakan port 6543 (Connection Pooler) agar cepat dan anti-timeout di semua jaringan seluler/WiFi:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# 2. SUPABASE_URL (URL Project Supabase)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL="https://your-project-id.supabase.co"

# 3. SUPABASE_SERVICE_ROLE_KEY (Kunci Rahasia untuk upload foto produk & logo)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# 4. JWT_SECRET (Kunci keamanan token login admin/owner)
JWT_SECRET="warkop-nusantara-jwt-secret-key-2026-super-secure"

# Port Server Lokal (Default: 3000)
PORT=3000
